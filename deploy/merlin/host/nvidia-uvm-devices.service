# /etc/systemd/system/nvidia-uvm-devices.service on the GPU host.
# /dev/nvidia-uvm* are not created at boot; the containers need them to exist.
[Unit]
Description=Create NVIDIA UVM device nodes for containers
Requires=nvidia-persistenced.service
After=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-modprobe -c0 -u

[Install]
WantedBy=multi-user.target
