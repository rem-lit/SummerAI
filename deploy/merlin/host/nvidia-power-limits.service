# /etc/systemd/system/nvidia-power-limits.service on the GPU host.
# Power limits are lost when the driver reloads; this unit sets them at boot.
# The RTX 3090 limit comes from benchmarks/power-limit/.
[Unit]
Description=Set NVIDIA GPU power limits
Requires=nvidia-persistenced.service
After=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
# RTX 3090
ExecStart=/usr/bin/nvidia-smi -i 00000000:01:00.0 -pl 300

[Install]
WantedBy=multi-user.target
