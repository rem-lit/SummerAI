# /etc/systemd/system/llama-server@.service in the GPU containers.
# One instance per model: llama-server@chat on the RTX 3090, llama-server@embed
# and llama-server@rerank on the RTX 3060. The arguments of an instance are in
# /etc/llama/<instance>.conf. Instances listen on loopback only; the local
# Caddy is the only network listener (ADR 0008).
[Unit]
Description=llama-server (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=llama
Group=llama
SupplementaryGroups=gpu
EnvironmentFile=/etc/llama/%i.conf
# Unbraced, so that systemd splits the arguments on whitespace.
ExecStart=/opt/llama.cpp/current/bin/llama-server $LLAMA_ARGS
Restart=on-failure
RestartSec=5

# Sandboxing. MemoryDenyWriteExecute is left out: the CUDA driver needs it off.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/llama /etc/llama
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
